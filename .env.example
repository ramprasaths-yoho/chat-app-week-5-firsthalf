# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/chatapp

# Comma-separated list of valid API keys clients send in the X-API-Key header
API_KEYS=dev-key-1,dev-key-2

# LLM provider
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Pricing in USD per 1M tokens (update for your model)
PRICE_INPUT_PER_M=0.15
PRICE_OUTPUT_PER_M=0.60

# Rate limit + sliding window
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SECONDS=3600
MAX_CONTEXT_TOKENS=3000
MAX_CONTEXT_MESSAGES=20
